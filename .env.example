# Copy to .env.local. No credentials needed for the fictional demo workspace.
APP_DATA_MODE=demo

# Optional live integration; leave empty for the foundation.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, read-only dashboard integration. Never prefix NEXT_PUBLIC_.
CIC_REPORTING_API_KEY=

# Optional AI assistant. Server-only; never use NEXT_PUBLIC_ for these.
# OpenAI API use requires API credits (separate from a ChatGPT subscription).
OPENAI_API_KEY=
\n+# Optional sponsored OHack gateway (takes precedence while configured).
# Team keys expire Nov 15, 2026 at 6 PM America/Phoenix.
OHACK_API_KEY=
OHACK_MODEL=gpt-oss-120b
OPENAI_MODEL=gpt-5.4-mini
# At least 32 securely generated random characters. Required in production.
AI_ACTION_SECRET=
# Production demo is disabled unless explicitly enabled; development demo works
# with a configured key. Enabling this permits paid requests from demo visitors.
AI_DEMO_ENABLED=false
